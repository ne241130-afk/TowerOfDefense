diff --git a/Assets/Components/systemManager/WaveManager.cs b/Assets/Components/systemManager/WaveManager.cs
new file mode 100644
index 0000000..6ab2668
--- /dev/null
+++ b/Assets/Components/systemManager/WaveManager.cs
@@ -0,0 +1,92 @@
+using UnityEngine;
+using UnityEngine.Events;
+
+/// <summary>
+/// Int を引数に取る UnityEvent の簡易定義
+/// </summary>
+[System.Serializable]
+public class IntEvent : UnityEvent<int> {}
+
+/// <summary>
+/// ターン進行に追従して Wave/Turn を管理するシンプルなマネージャ。
+/// - TurnManager に Register しておくことで AdvanceTurn ごとに OnTurnTick が呼ばれる。
+/// - Inspector で turnsPerWave を設定可能（デフォルト 5）。
+/// - OnWaveStarted(OnWaveCompleted/OnTurnChanged) は Inspector から UI に紐付け可能。
+/// </summary>
+public class WaveManager : MonoBehaviour, ITurnActor
+{
+    [Tooltip("1Wave に含まれるターン数")]
+    public int turnsPerWave = 5;
+
+    [Header("状態（読み取り専用）")]
+    public int currentWave = 1;
+    public int turnInWave = 0;
+
+    [Header("イベント（Inspector で UI 等を登録）")]
+    public IntEvent OnWaveStarted;   // 引数: waveNumber
+    public IntEvent OnWaveCompleted; // 引数: waveNumber (その Wave が完了したとき)
+    public IntEvent OnTurnChanged;   // 引数: turnInWave (1..turnsPerWave)
+
+    private void Start()
+    {
+        // TurnManager に登録しておく（TurnManager.AdvanceTurn が呼ばれると OnTurnTick が呼ばれる）
+        if (TurnManager.Instance != null)
+        {
+            TurnManager.Instance.Register(this);
+        }
+        else
+        {
+            Debug.LogWarning("WaveManager: TurnManager が見つかりません。Start 時に登録できませんでした。");
+        }
+
+        // 初期状態：Wave 1 は未開始（turnInWave = 0）。必要ならここで OnWaveStarted を呼ぶ。
+    }
+
+    private void OnDestroy()
+    {
+        if (TurnManager.Instance != null)
+        {
+            TurnManager.Instance.Unregister(this);
+        }
+    }
+
+    /// <summary>
+    /// TurnManager から呼ばれる（1ターン進む毎に実行される）。
+    /// </summary>
+    public void OnTurnTick()
+    {
+        // ターンカウントを進める
+        turnInWave++;
+
+        // もし turnInWave が設定した上限を超えたら新しい Wave に移行して turn を 1 にリセット
+        if (turnInWave > turnsPerWave)
+        {
+            // 現在の Wave が完了して、次の Wave が始まる
+            currentWave++;
+            turnInWave = 1;
+            OnWaveStarted?.Invoke(currentWave);
+            OnTurnChanged?.Invoke(turnInWave);
+            return;
+        }
+
+        // 通常のターン更新通知
+        OnTurnChanged?.Invoke(turnInWave);
+
+        // このターンで Wave がちょうど完了する場合（例: 5ターン目）
+        if (turnInWave == turnsPerWave)
+        {
+            OnWaveCompleted?.Invoke(currentWave);
+            // WaveCompleted は通知のみ、Wave の切り替えは次の OnTurnTick で行う（挙動を変えたい場合はここで currentWave++ / turnInWave=0 にする）
+        }
+    }
+
+    /// <summary>
+    /// ゲーム再開やリスタート時に状態をリセットしたければ呼ぶ
+    /// </summary>
+    public void ResetState(int startWave = 1)
+    {
+        currentWave = Mathf.Max(1, startWave);
+        turnInWave = 0;
+        // UI 更新を明示的に行いたければここで OnWaveStarted/OnTurnChanged を呼ぶ
+    }
+}
